#
# notice multiple compose files combined..
#
# COMPOSE_FILE=docker-compose.yml:docker-compose-pg.yml
COMPOSE_FILE=docker-compose.yml:docker-compose-mysql.yml


# notes: 
#
# had to specify tcp for the host when using dkr service name like dgmm:3306
# eg: MEMOS_DSN="muser:x@tcp(dbm:3306)/memos?parseTime=true"
# nowork: MEMOS_DSN="mysql://--redacted--@dbm:3306/memos" memos
# eg: MEMOS_DSN="postgres://--redacted--@dbp:5432/memos?sslmode=disable" memos
#

# mysql:
MYSQL_HOST=dbm
MYSQL_DATABASE=memos
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=
MYSQL_USER=muser
MYSQL_PASSWORD=

# postgres:
POSTGRES_HOST=dbp
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=memos

#2020-07-26 10:05AM David Gleba added timezone
TZ=America/Detroit
