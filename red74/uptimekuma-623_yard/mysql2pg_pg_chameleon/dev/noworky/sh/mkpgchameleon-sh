#!/usr/bin/env bash
set -euo pipefail

BASE_DIR="$(pwd)"

mkdir -p \
  "$BASE_DIR/pgchameleon/config" \
  "$BASE_DIR/../sysdata/pgchameleon/state" \
  "$BASE_DIR/../sysdata/dbpdata"

#############################################
# docker-compose.yml
#############################################
cat >> "$BASE_DIR/docker-compose.yml" <<'EOF'

# ------------

  dbp:
    image: postgres:18-alpine
    #container_name: dbp
    restart: always
    environment:
      POSTGRES_DB: pgcham
      POSTGRES_USER: pgcham
      POSTGRES_PASSWORD: ${PG_PASSWORD}
    ports:
      - "5438:5432"
    volumes:
      - ../sysdata/dbpdata:/var/lib/postgresql/data
      - /etc/localtime:/etc/localtime:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U pgcham -d pgcham"]
      interval: 60s
      timeout: 12s
      retries: 10
      start_period: 10s
    networks:
      - default

  pgchameleon:
    image: pgchameleon/pgchameleon:3.0
    #container_name: pgchameleon
    restart: always
    depends_on:
      dbp:
        condition: service_healthy
    environment:
      MYSQL_HOST: dbm
      MYSQL_PORT: 3306
      MYSQL_USER: root
      MYSQL_PASSWORD: ${MYSQL_PASSWORD}

      PG_HOST: dbp
      PG_PORT: 5432
      PG_USER: pgcham
      PG_PASSWORD: ${PG_PASSWORD}
      PG_DATABASE: pgcham
    volumes:
      - ../sysdata/pgchameleon/state:/var/lib/pgchameleon
      - ./pgchameleon/config:/etc/pgchameleon/config
    healthcheck:
      test: ["CMD-SHELL", "chameleon status c01 || exit 1"]
      interval: 60s
      timeout: 15s
      retries: 10
      start_period: 10s
    command: >
      sh -c "
        envsubst < /etc/pgchameleon/config/config-c01.yml > /etc/pgchameleon/config/config.yml &&
        chameleon setconf c01 &&
        chameleon create_replica c01 &&
        chameleon start_replica c01
      "
    networks:
      - default
EOF

#############################################
# pg_chameleon config template
#############################################
cat > "$BASE_DIR/pgchameleon/config/config-c01.yml" <<'EOF'
source:
  db_conn:
    host: ${MYSQL_HOST}
    port: ${MYSQL_PORT}
    user: ${MYSQL_USER}
    passwd: ${MYSQL_PASSWORD}
    charset: utf8
    connect_timeout: 10

target:
  db_conn:
    host: ${PG_HOST}
    port: ${PG_PORT}
    user: ${PG_USER}
    passwd: ${PG_PASSWORD}
    database: ${PG_DATABASE}

replica:
  batch_size: 10000
  limit_tables: []
  limit_schemas: []
  skip_tables: []
  skip_schemas: []
EOF

echo "All files created successfully (no secrets stored)."

