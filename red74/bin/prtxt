find . \
  -path ./xclud -prune -o \
  -path ./sysdata -prune -o \
  -name out.txt -prune -o \
  -name "*.ico" -prune -o \
  -type f | sort \
  | while read -r f; do
      echo -e "###  ==================   $f   ==================\n"
      cat "$f"
      echo
  done > out.txt

echo -e "\n  Files were printed to out.txt\n"
